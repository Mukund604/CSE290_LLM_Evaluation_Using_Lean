# Copy to `.env` and fill in. `.env` is gitignored.
# Either set the per-provider keys OR set OPENROUTER_API_KEY and use
# `--provider openrouter` with provider-prefixed model ids
# (e.g. anthropic/claude-opus-4.7, google/gemini-2.5-pro). Pick one
# path — using openrouter only also keeps the budget on a single bill.
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AI...
OPENROUTER_API_KEY=sk-or-v1-...
